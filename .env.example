# ── API-ключи (никогда не коммить реальные значения; .env в .gitignore) ──
# Эмбеддинги: Jina (https://jina.ai/embeddings). jina-embeddings-v3 — как в оригинале. Без него -> dry-run.
JINA_API_KEY=

# LLM-вердикты: мульти-провайдер с фолбэком. Достаточно хотя бы одного ключа.
# При 429/ошибке агент переходит к следующему провайдеру из LLM_PROVIDERS по порядку.
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=

# Порядок перебора провайдеров (через запятую). Первым — самый быстрый/щедрый по лимитам.
LLM_PROVIDERS=cerebras,openrouter,mistral,gemini,cohere

# Модель на провайдера (опционально переопределить дефолты):
# CEREBRAS_MODEL=llama-3.3-70b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# MISTRAL_MODEL=mistral-small-latest
# GEMINI_MODEL=gemini-2.0-flash
# COHERE_MODEL=command-r-08-2024

# ── Эмбеддинги ──
EMBED_MODEL=jina-embeddings-v3
EMBED_URL=https://api.jina.ai/v1/embeddings

# ── Параметры пайплайна ──
EMBED_DIM=1024
CHUNK_MAX_CHARS=900
CHUNK_OVERLAP_CHARS=120
MAX_CHUNKS_PER_PAPER=0     # 0 = без лимита (индексировать статью целиком); >0 = потолок чанков
TOP_K_PAPERS=6
SEARCH_LIMIT=8
AGENT_MAX_ITERS=2

# ── Контроль нагрузки на LLM (против 429 Too Many Requests) ──
# Минимальный интервал между ЛЮБЫМИ LLM-вызовами, сек (сериализует burst).
LLM_MIN_INTERVAL=1.0
# Попыток на ОДНОГО провайдера при 429/5xx (потом фолбэк к следующему). Меньше = быстрее переключение.
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE=1.6
# AGENT_LOOP=false (по умолчанию) -> быстрый БАТЧ-вердикт: 1 plan + 1 вызов на ВСЕ статьи.
# AGENT_LOOP=true -> полная агентность: поштучный цикл "хватает ли доказательств" (медленно, для демо).
AGENT_LOOP=false
SELF_VERIFY=true

# ── Режимы ──
# HYBRID=true включает sparse(BM25)+dense с RRF-слиянием (как в оригинале).
HYBRID=false
# DRY_RUN=true принудительно отключает все вызовы LLM/эмбеддингов.
DRY_RUN=false

# ── Пути ──
PAPERS_DIR=papers
QDRANT_PATH=qdrant_db
QDRANT_COLLECTION=thesis_papers
OUTPUT_DIR=output
